{
  "expo": {
    "name": "Mão Com Mão",
    "slug": "maocommao-chamada",
    "scheme": "maocommao",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.maocommao.chamada",
      "versionCode": 5,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ler a carteirinha do aluno para registrar a presença."
        }
      ]
    ]
  }
}